# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for auth redirects and Poketo redirectUrl)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used by the webhook, cron, and admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# Poketo (dashboard -> Merchants -> API settings). Use sk_test_ in development.
POKETO_SECRET_KEY=sk_test_
# Webhook signing secret shown when you add the webhook URL
POKETO_WEBHOOK_SECRET=whsec_

# Shared secret for /api/cron/check-invoices (sent as "Authorization: Bearer <value>")
CRON_SECRET=
